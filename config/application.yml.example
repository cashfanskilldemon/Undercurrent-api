# 本地开发配置模板：复制成同目录下的 application.yml 再填真实值
#   cp config/application.yml.example config/application.yml
#
# 外置 config/ 目录的优先级高于 classpath 里的 application.yml，
# 因此这里的值会覆盖 src/main/resources/application.yml 中的默认值。
# config/application.yml 已被 .gitignore 忽略，不会进仓库。
spring:
  datasource:
    # 库名大小写敏感，Linux 上 MySQL 会区分 Undercurrent_test / undercurrent_test
    url: jdbc:mysql://127.0.0.1:3306/Undercurrent_test?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
    username: root
    password: ''
